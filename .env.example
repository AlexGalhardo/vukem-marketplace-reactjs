# Copy to .env and run `vukem key:generate`. Never commit .env.
# Railway: set the same keys as service variables (see PLAN.md, Developer actions).

# --- App ---
APP_NAME="Vukem Marketplace"
APP_ENV=development
APP_KEY=
# Former APP_KEY values, comma-separated: they still decrypt after a rotation.
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost:3000
APP_LOCALE=en
APP_VERSION=dev
HOST=localhost
PORT=3000
# Extra origins allowed to send unsafe requests (comma-separated).
CSRF_TRUSTED_ORIGINS=

# --- Postgres (core data) --- `docker compose up -d postgres` exposes 5442.
DATABASE_URL=postgres://marketplace:marketplace@localhost:5442/marketplace?sslmode=disable

# --- Redis (sessions, cache, queues, rate limits) --- compose: 6389.
REDIS_URL=redis://localhost:6389/0
REDIS_PREFIX=mkt:

# --- MongoDB (audit log, telemetry, view/search history) --- compose: 27027.
MONGO_URL=mongodb://localhost:27027/marketplace
# Database name when MONGO_URL has no path (Railway plugin URL); default: marketplace.
# MONGO_DATABASE=marketplace

# --- Mail (vukem SMTP driver) ---
# Dev/staging/e2e: Mailtrap Email Sandbox (Sandboxes > Integration > SMTP).
# Fully offline alternative: Mailpit from compose (SMTP_HOST=localhost SMTP_PORT=1035
# SMTP_INSECURE=true, UI at http://localhost:8035).
# Railway blocks outbound SMTP: production uses the Mailtrap Email API
# (HTTP) with MAIL_MAILER=mailtrap, MAILTRAP_API_TOKEN and MAILTRAP_INBOX_ID
# (an inbox id sends to the sandbox; without it, the sending API).
MAIL_MAILER=smtp
# MAILTRAP_INBOX_ID=
MAIL_FROM="Vukem Marketplace <no-reply@marketplace.vukem.dev>"
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_INSECURE=false
# Mailtrap Sandbox API, used by integration/e2e tests to read delivered emails.
MAILTRAP_API_TOKEN=
MAILTRAP_ACCOUNT_ID=
MAILTRAP_SANDBOX_ID=

# --- Object storage (product images) --- compose RustFS: 9200 (console 9201).
# Vercel Blob (public store) wins over S3 when set: BLOB_READ_WRITE_TOKEN=vercel_blob_rw_<store>_<secret>
BLOB_READ_WRITE_TOKEN=
S3_ENDPOINT=http://localhost:9200
S3_REGION=us-east-1
S3_BUCKET=marketplace
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
S3_USE_PATH_STYLE=true
S3_INSECURE_HTTP=true
S3_PUBLIC_URL=

# --- Auth (Auth phase) ---
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=

# --- Payments (Payments phases, test/sandbox mode only) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Comma-separated: platform endpoint secret, Connect endpoint secret.
STRIPE_WEBHOOK_SECRETS=
PLATFORM_FEE_BPS=1000
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=
# Optional: defaults to https://api.abacatepay.com (https required in production).
ABACATEPAY_BASE_URL=
# Optional: the public HMAC key AbacatePay documents for X-Webhook-Signature (built in).
ABACATEPAY_WEBHOOK_PUBLIC_KEY=

# --- Telegram (contact form + 5xx alerts) --- no-op while unset.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Keep false: vukem would otherwise forward every error log (which can quote
# request data) to the chat; only the rate-limited 5xx alerts (one per route
# per 10 min) and contact messages are sent.
TELEGRAM_LOG=false

# --- Background work ---
# serve runs a queue worker and the scheduler in process (single Railway
# service). Set both to false when separate queue:work / schedule:work
# processes run (compose worker + scheduler services).
QUEUE_IN_SERVE=true
SCHEDULE_IN_SERVE=true
# app.RateLimiters() (contact form, API) counts in the Redis cache so every
# instance shares the budget; requires REDIS_URL (use memory without Redis).
RATE_LIMIT_STORE=cache

# --- Observability (OpenTelemetry → Railway tracing) ---
# Traces are off while no endpoint is set. Metrics (HTTP, outbound HTTP, DB,
# queue) follow the generic endpoint since drivers/otel v0.3.0, or
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT. Railway's tracing receiver accepts
# traces only, so production sets OTEL_METRICS_EXPORTER=none. SQL text is
# never exported. Every OTEL_* value is read from here or the process env.
OTEL_SERVICE_NAME=marketplace
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_METRICS_EXPORTER=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=

# --- gRPC (own port, contrib/grpc Server; Railway TCP proxy) ---
# "off" disables the port. API keys travel in metadata: production needs TLS
# (cert/key files) or GRPC_INSECURE_CLEARTEXT=true behind a TLS proxy, else
# gRPC is not served and an error is logged. HTTP_H2C does not open this port
# in cleartext (it only affects the HTTP port).
GRPC_PORT=50051
GRPC_TLS_CERT_FILE=
GRPC_TLS_KEY_FILE=
GRPC_INSECURE_CLEARTEXT=false

# --- Public APIs (REST /api/v1, GraphQL, gRPC) ---
# Requests per minute per API key / session user (anonymous: per IP).
API_RATE_LIMIT=120
# GraphQL introspection is off in production unless this is true.
GRAPHQL_INSECURE_INTROSPECTION=false

# --- docker compose host ports (optional overrides) ---
# MKT_APP_PORT=3200
# MKT_GRPC_PORT=50061
# MKT_PG_PORT=5442
# MKT_REDIS_PORT=6389
# MKT_MONGO_PORT=27027
# MKT_S3_PORT=9200
# MKT_S3_CONSOLE_PORT=9201
# MKT_SMTP_PORT=1035
# MKT_MAILPIT_PORT=8035

# Demo users (vukem db:seed; refused when APP_ENV=production). Default: marketplace-demo-password
# buyer@, seller@ and admin@example.com share it (min. 12 chars); the admin's TOTP
# secret is logged once on creation. See README "Contas de desenvolvimento".
# db:seed also seeds the demo catalog (100 sellers, 2000 products); in production
# only `demo:catalog --allow-production` does.
SEED_PASSWORD=

# --- Reverse proxy (production on Railway) ---
# Trust the edge range only, so c.IP() and HSTS cannot be spoofed by clients.
# TRUSTED_PROXIES=100.64.0.0/10
# CLIENT_IP_HEADER=X-Real-IP
# TRUST_FORWARDED_PROTO=true

# Chat: how long a recipient must be away (no open chat socket, no page
# rendered) before unread messages are emailed, as a Go duration.
CHAT_NOTIFY_AFTER=10m

# --- Telegram (ops channel) ---
# Backend (vukem logging/telegram): 5xx alerts and contact messages need a bot
# token and chat id; TELEGRAM_LOG=true also forwards logs at or above
# TELEGRAM_MIN_LEVEL (debug|info|warn|error), panics included.
# Browser errors use the same bot through the client-logger service
# (telegram-logger); docs/telegram-logging.md has the whole setup.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_LOG=true
# TELEGRAM_MIN_LEVEL=warn
# CLIENT_LOGGER_URL=http://client-logger:3100
# CLIENT_LOGGER_KEY=   # shared secret, 16+ chars (openssl rand -hex 24)
