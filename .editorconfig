root = true

# Tabs (width 4) everywhere; YAML forbids tabs and Markdown lists render
# inconsistently with them, so those two use 2 spaces.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4
tab_width = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{ps1,psm1,bat,cmd}]
end_of_line = crlf
